# Nginx configuration for the AtlasLM production backend API.
# Public boundary:
#   Internet -> 80/443 Nginx -> FastAPI on 127.0.0.1:8080
#
# Do not expose Mastra, Redis, PostgreSQL, workers, or internal Atlas tool routes.

server {
    listen 80;
    listen [::]:80;
    server_name api.atlaslm.cloud;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.atlaslm.cloud;

    ssl_certificate /etc/letsencrypt/live/api.atlaslm.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.atlaslm.cloud/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:atlaslm_api_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    client_max_body_size 50M;

    location ^~ /internal/atlas/ {
        return 404;
    }

    location /docs {
        return 404;
    }

    location /redoc {
        return 404;
    }

    location /openapi.json {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
