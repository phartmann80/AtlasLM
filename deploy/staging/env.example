# AtlasLM staging.env names
#
# Install as root into /etc/atlaslm/staging.env (already exists, root:root, mode 0600).
# Do not change /etc/atlaslm permissions (directory mode 0700).
# Fill values on the server. Never commit real values.
# After filling, run: python3 deploy/validate_staging_env.py /etc/atlaslm/staging.env
# The validator reports only SET, EMPTY, MISSING, VALID_FORMAT, INVALID_FORMAT.
#
# NEXT_PUBLIC_* values are required at frontend image build time.
# Never add SUPABASE_SERVICE_ROLE_KEY to frontend build args.
# Full classification: docs/STAGING_FIRST_ENV_REQUIREMENTS.md

# Automatically set by atlaslmctl at deploy time. Leave empty in this file.
ATLAS_RELEASE_SHA=

# Generate securely on the server. Never reuse production.
DB_PASSWORD=
JWT_SECRET=

# Retrieve from a dedicated non-production Supabase project. Public URL and anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fixed non-secret staging values
NEXT_PUBLIC_API_BASE=/api/v1
STAGING_FRONTEND_HOST=staging.atlaslm.cloud
STAGING_API_HOST=api.staging.atlaslm.cloud
FRONTEND_URL=https://staging.atlaslm.cloud
APP_URL=https://staging.atlaslm.cloud
ATLAS_PUBLIC_BACKEND_URL=https://api.staging.atlaslm.cloud
ATLAS_ALLOWED_ORIGINS=https://staging.atlaslm.cloud
ATLAS_ENV=staging

# Backend-only. Never pass these as frontend image build arguments.
# Retrieve SUPABASE_SERVICE_ROLE_KEY from the same dedicated Supabase project.
SUPABASE_SERVICE_ROLE_KEY=
# Generate securely on the server.
ATLAS_INTERNAL_SIGNING_SECRET=
ATLAS_VAULT_KEY=
ATLAS_VAULT_KEY_ID=v1

# First-staging AI provider: Langdock. Retrieve credentials from Langdock, not production.
ATLAS_ACTIVE_PROVIDER=langdock
LANGDOCK_API_KEY=
LANGDOCK_API_CODE=
LANGDOCK_ENDPOINT_URL=https://api.langdock.com/openai/eu/v1
LANGDOCK_MODEL=gpt-5-mini

# Optional. Leave empty for first staging.
MODEL=
BLACKBOX_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Mastra container stays in the stack. Gateway values stay empty until a
# reviewed non-production gateway exists. Do not use the production gateway.
GATEWAY_API_URL=
GATEWAY_API_MASTRA_KEY=
MASTRA_MODEL=

# Keep SearXNG / Deep Research / extra Studio tools disabled for this staging release.
ATLAS_CHAT_RUNTIME=legacy
ATLAS_REPORT_RUNTIME=legacy
ATLAS_RESEARCH_RUNTIME=legacy
ATLAS_MEMORY_MODE=off
ATLAS_TRACE_CONTENT=redacted
RESEARCH_HTTP_TIMEOUT=12
ATLAS_DEFAULT_SEAT_LIMIT=5
