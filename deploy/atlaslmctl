#!/usr/bin/env python3
"""Root-owned AtlasLM staging control wrapper.

Install later as /usr/local/sbin/atlaslmctl (root:root, mode 0750).
This copy is for review only and is not installed by this change.

Supported argv when installed:
  atlaslmctl staging deploy <40-character-sha>
  atlaslmctl staging rollback <40-character-sha>
  atlaslmctl staging status
  atlaslmctl staging logs

Caller-controlled options, environment paths, remotes, project names, and
health URLs are ignored when the wrapper runs with privilege. Compose,
Dockerfiles, migrations, and Caddy are executed only from a verified
root-owned release of the requested SHA.
"""

from __future__ import annotations

import os
import re
import shutil
import stat
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Mapping, Sequence

SHA_RE = re.compile(r"^[0-9a-f]{40}$")
SAFE_RELATIVE = re.compile(r"^[A-Za-z0-9._/-]+$")
FORBIDDEN_WORDS = ("production", "prod", "live")
PRODUCTION_HEALTH = "https://api.atlaslm.cloud/health"

FIXED_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
FIXED_PROJECT = "atlaslm-staging"
FIXED_ENV_FILE = Path("/etc/atlaslm/staging.env")
FIXED_TRUST_ROOT = Path("/srv/atlaslm")
FIXED_GIT_REMOTE = "https://github.com/phartmann80/AtlasLM.git"
FIXED_APPROVED_REF = "refs/heads/main"
FIXED_HEALTH_URL = "https://api.staging.atlaslm.cloud/health"
FIXED_STAGING_HOST = "staging.atlaslm.cloud"
FIXED_API_HOST = "api.staging.atlaslm.cloud"
ALLOWED_GIT_REMOTES = frozenset(
    {
        "https://github.com/phartmann80/AtlasLM.git",
        "https://github.com/phartmann80/AtlasLM",
    }
)

# GitHub rejects git's HTTP/2 upload-pack POST from the staging host (Sep 2026).
# HTTP/1.1 is deterministic. protocol.version stays default (v2).
GIT_TRANSPORT_OPTS: tuple[str, ...] = ("-c", "http.version=HTTP/1.1")

COMPOSE_REL = Path("deploy/staging/docker-compose.yaml")
CADDY_REL = Path("deploy/staging/Caddyfile")
MIGRATE_REL = Path("deploy/migrate.py")
MANIFEST_REL = Path("deploy/migrations.manifest.json")
WRAPPER_REL = Path("deploy/atlaslmctl")
REQUIRED_RELATIVE_FILES = (
    COMPOSE_REL,
    CADDY_REL,
    MIGRATE_REL,
    MANIFEST_REL,
    WRAPPER_REL,
    Path("frontend/Dockerfile"),
    Path("backend/Dockerfile"),
    Path("mastra/Dockerfile"),
)

BUILD_SERVICES = ("frontend", "backend", "mastra")
DATA_SERVICES = ("postgres", "redis")
APP_SERVICES = ("worker", "mastra", "frontend", "caddy")
ROLLBACK_SERVICES = ("frontend", "backend", "worker", "mastra", "caddy")
IMAGE_PREFIXES = (
    "atlaslm-staging-frontend",
    "atlaslm-staging-backend",
    "atlaslm-staging-mastra",
)

CALLER_ENV_OVERRIDE_NAMES = (
    "ATLASLM_APP_ROOT",
    "ATLASLM_REPO",
    "ATLASLM_STAGING_ENV_FILE",
    "ATLASLM_COMPOSE_PROJECT",
    "ATLASLM_HEALTH_URL",
    "ATLASLM_STAGING_HOST",
    "ATLASLM_API_HOST",
    "ATLASLM_GIT_REMOTE",
    "ATLASLM_APPROVED_REF",
    "ATLASLM_RELEASES_DIR",
    "ATLASLMCTL_DRY_RUN",
    "COMPOSE_FILE",
    "COMPOSE_PROJECT_NAME",
    "COMPOSE_PATH_SEPARATOR",
    "DOCKER_HOST",
    "DOCKER_CONTEXT",
    "DOCKER_CONFIG",
    "GIT_DIR",
    "GIT_WORK_TREE",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_CONFIG_GLOBAL",
    "GIT_CONFIG_SYSTEM",
    "PYTHONPATH",
    "PYTHONHOME",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "http_proxy",
    "https_proxy",
    "all_proxy",
    "NO_PROXY",
    "no_proxy",
)


class AtlasLMCtlError(Exception):
    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.code = code


def _fail(message: str, code: int = 2) -> None:
    raise AtlasLMCtlError(message, code)


@dataclass
class TrustedConfig:
    """Fixed execution configuration. Tests assign this via module hook only."""

    root: Path
    env_file: Path
    git_remote: str
    approved_ref: str
    project: str
    health_url: str
    required_uid: int
    required_gid: int
    path: str = FIXED_PATH
    dry_run: bool = False
    command_log: list[list[str]] | None = None
    existing_images: frozenset[str] | None = None
    git_bin: str = "/usr/bin/git"
    docker_bin: str = "/usr/bin/docker"


PRODUCTION_CONFIG = TrustedConfig(
    root=FIXED_TRUST_ROOT,
    env_file=FIXED_ENV_FILE,
    git_remote=FIXED_GIT_REMOTE,
    approved_ref=FIXED_APPROVED_REF,
    project=FIXED_PROJECT,
    health_url=FIXED_HEALTH_URL,
    required_uid=0,
    required_gid=0,
)

# Test-only hooks. Cannot be set through argv or process environment.
_test_config: TrustedConfig | None = None
_test_force_privileged: bool | None = None


def is_privileged() -> bool:
    if _test_force_privileged is not None:
        return _test_force_privileged
    return os.geteuid() == 0


def config() -> TrustedConfig:
    if _test_config is not None:
        return _test_config
    return PRODUCTION_CONFIG


def incoming_dir(cfg: TrustedConfig | None = None) -> Path:
    return (cfg or config()).root / "incoming"


def releases_dir(cfg: TrustedConfig | None = None) -> Path:
    return (cfg or config()).root / "releases"


def runtime_link(cfg: TrustedConfig | None = None) -> Path:
    return (cfg or config()).root / "runtime" / "staging"


def release_dir(sha: str, cfg: TrustedConfig | None = None) -> Path:
    return releases_dir(cfg) / sha


def image_names(sha: str) -> tuple[str, ...]:
    return tuple(f"{prefix}:{sha}" for prefix in IMAGE_PREFIXES)


def validate_sha(value: str) -> str:
    sha = value.strip().lower()
    if sha != value.strip() or not SHA_RE.fullmatch(sha):
        _fail("release id must be an exact 40-character lowercase hexadecimal Git SHA")
    return sha


def reject_forbidden(tokens: Sequence[str]) -> None:
    for token in tokens:
        lowered = token.strip().lower()
        if lowered.startswith("-"):
            _fail("unknown argument")
        if lowered in FORBIDDEN_WORDS:
            _fail(f"rejected argument: {token}")
        if "production" in lowered or lowered.endswith("-prod"):
            _fail(f"rejected argument: {token}")
        if token in {"-f", "--file"} or lowered.startswith("--file=") or "docker-compose.searxng" in lowered:
            _fail("unapproved compose file")


def clean_subprocess_env(cfg: TrustedConfig, extra: Mapping[str, str] | None = None) -> dict[str, str]:
    env = {
        "PATH": cfg.path,
        "HOME": "/root" if cfg.required_uid == 0 else os.path.expanduser("~"),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "SHELL": "/bin/sh",
        "TZ": "UTC",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null",
        "ATLAS_RELEASE_SHA": extra.get("ATLAS_RELEASE_SHA", "") if extra else "",
    }
    if extra:
        env.update(extra)
    for name in CALLER_ENV_OVERRIDE_NAMES:
        env.pop(name, None)
    env.pop("PYTHONPATH", None)
    env.pop("PYTHONHOME", None)
    env.pop("DOCKER_HOST", None)
    env.pop("GIT_DIR", None)
    return env


def maybe_reexec_isolated(argv: Sequence[str]) -> None:
    if os.geteuid() != 0 or _test_config is not None:
        return
    if os.environ.get("ATLASLMCTL_CLEAN_ENV") == "1":
        return
    cfg = PRODUCTION_CONFIG
    env = clean_subprocess_env(cfg)
    env["ATLASLMCTL_CLEAN_ENV"] = "1"
    script = str(Path(__file__).resolve())
    os.execve(sys.executable, [sys.executable, "-I", script, *argv], env)


def sanitize_log_line(line: str) -> str:
    redacted = re.sub(
        r"(?i)(password|secret|token|key|authorization)=([^\s]+)",
        r"\1=<redacted>",
        line,
    )
    redacted = re.sub(r"(?i)bearer\s+[A-Za-z0-9._\-]+", "bearer <redacted>", redacted)
    redacted = re.sub(
        r"(?i)(x-gladia-key|x-api-key)\s*[:=]\s*\S+",
        r"\1=<redacted>",
        redacted,
    )
    return redacted.rstrip()


def _run(
    cmd: Sequence[str],
    *,
    cfg: TrustedConfig,
    cwd: Path | None = None,
    git: bool = False,
    capture: bool = False,
    extra_env: Mapping[str, str] | None = None,
) -> str:
    env = clean_subprocess_env(cfg, extra_env)
    if cfg.command_log is not None:
        cfg.command_log.append(list(cmd))
    if cfg.dry_run and not git:
        return ""
    try:
        completed = subprocess.run(
            list(cmd),
            check=True,
            text=True,
            cwd=str(cwd) if cwd else None,
            env=env,
            capture_output=True,
        )
    except FileNotFoundError:
        _fail(f"command not found: {cmd[0]}")
    except subprocess.CalledProcessError as exc:
        detail = ""
        if git:
            lines = [sanitize_log_line(l) for l in (exc.stderr or "").strip().splitlines() if l.strip()]
            tail = " | ".join(lines[-3:])[:400]
            detail = f" :: {tail}" if tail else ""
        _fail(f"command failed with exit {exc.returncode}: {cmd[0]}{detail}", code=exc.returncode or 1)
    if capture:
        return completed.stdout.strip()
    return completed.stdout or ""


def git_cmd(cfg: TrustedConfig, args: Sequence[str], *, cwd: Path | None = None, capture: bool = True) -> str:
    git = cfg.git_bin if Path(cfg.git_bin).is_file() else "git"
    return _run([git, *GIT_TRANSPORT_OPTS, *args], cfg=cfg, cwd=cwd, git=True, capture=capture)


def path_is_within(root: Path, candidate: Path) -> bool:
    try:
        candidate.resolve().relative_to(root.resolve())
        return True
    except (OSError, ValueError):
        return False


def _mode_group_or_world_writable(mode: int) -> bool:
    return bool(mode & 0o022)


def assert_trusted_path(path: Path, cfg: TrustedConfig, *, follow: bool = False) -> None:
    st = path.stat() if follow else path.lstat()
    if st.st_uid != cfg.required_uid:
        _fail("path is not trusted-owner")
    if _mode_group_or_world_writable(st.st_mode):
        _fail("path is group or world writable")


def assert_no_symlink_escape(root: Path, cfg: TrustedConfig) -> None:
    root_resolved = root.resolve()
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        current = Path(dirpath)
        try:
            st = current.lstat()
        except OSError:
            _fail("unreadable release path")
        if st.st_uid != cfg.required_uid or _mode_group_or_world_writable(st.st_mode):
            _fail("release tree is not trusted-owner or is writable by others")
        for name in [*dirnames, *filenames]:
            entry = current / name
            try:
                est = entry.lstat()
            except OSError:
                _fail("unreadable release path")
            if stat.S_ISLNK(est.st_mode):
                real = Path(os.path.realpath(entry))
                if not path_is_within(root_resolved, real):
                    _fail("symlink escape rejected")
                continue
            if est.st_uid != cfg.required_uid or _mode_group_or_world_writable(est.st_mode):
                _fail("release tree is not trusted-owner or is writable by others")


def assert_required_files(root: Path, cfg: TrustedConfig) -> None:
    root_resolved = root.resolve()
    for rel in REQUIRED_RELATIVE_FILES:
        if not SAFE_RELATIVE.fullmatch(rel.as_posix()):
            _fail("unapproved deployment path")
        candidate = root / rel
        if not candidate.exists():
            _fail("release is missing required deployment files")
        if not path_is_within(root_resolved, candidate):
            _fail("symlink escape rejected")
        real = candidate.resolve()
        if not path_is_within(root_resolved, real):
            _fail("symlink escape rejected")
        assert_trusted_path(candidate, cfg, follow=False)
        if incoming_dir(cfg).resolve() in real.parents or real == incoming_dir(cfg).resolve():
            _fail("refusing to execute atlasdeploy-writable content")


def git_commit_sha(root: Path, cfg: TrustedConfig) -> str:
    sha = git_cmd(cfg, ["rev-parse", "HEAD"], cwd=root)
    return validate_sha(sha)


def assert_commit_object(sha: str, cwd: Path, cfg: TrustedConfig) -> None:
    kind = git_cmd(cfg, ["cat-file", "-t", sha], cwd=cwd)
    if kind != "commit":
        _fail("release id must resolve to a commit object")
    peeled = git_cmd(cfg, ["rev-parse", "--verify", f"{sha}^{{commit}}"], cwd=cwd)
    if peeled != sha:
        _fail("release id must resolve to a commit object")


def assert_reachable_from_approved_ref(sha: str, cwd: Path, cfg: TrustedConfig) -> None:
    ref = cfg.approved_ref
    local_ref = "refs/heads/main" if ref in {"refs/heads/main", "main", "origin/main"} else ref
    try:
        git_cmd(cfg, ["merge-base", "--is-ancestor", sha, local_ref], cwd=cwd)
    except AtlasLMCtlError:
        try:
            git_cmd(cfg, ["merge-base", "--is-ancestor", sha, "refs/remotes/origin/main"], cwd=cwd)
        except AtlasLMCtlError:
            _fail("SHA is not reachable from the approved ref")


def verify_release_tree(
    root: Path,
    sha: str,
    cfg: TrustedConfig,
    *,
    require_dirname: bool = True,
) -> Path:
    sha = validate_sha(sha)
    if not root.is_dir():
        _fail("verified release not found")
    if require_dirname and root.name != sha:
        _fail("release directory does not match requested SHA")
    if not path_is_within(releases_dir(cfg), root):
        _fail("release path is outside trusted releases")
    if incoming_dir(cfg).exists() and path_is_within(incoming_dir(cfg), root):
        _fail("refusing to execute atlasdeploy-writable content")
    assert_trusted_path(root, cfg, follow=False)
    assert_no_symlink_escape(root, cfg)
    assert_required_files(root, cfg)
    if not (root / ".git").exists():
        _fail("release is not a Git checkout")
    assert_commit_object(sha, root, cfg)
    head = git_commit_sha(root, cfg)
    if head != sha:
        _fail("checked-out HEAD does not match requested SHA")
    assert_reachable_from_approved_ref(sha, root, cfg)
    compose = (root / COMPOSE_REL).resolve()
    if compose.parent.name != "staging" or compose.parent.parent.name != "deploy":
        _fail("unapproved compose file")
    return root


def _harden_tree_mode(root: Path, cfg: TrustedConfig) -> None:
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        current = Path(dirpath)
        os.chmod(current, stat.S_IMODE(current.stat().st_mode) & ~0o022)
        for name in filenames:
            entry = current / name
            if entry.is_symlink():
                continue
            os.chmod(entry, stat.S_IMODE(entry.stat().st_mode) & ~0o022)
        if os.geteuid() == 0 and cfg.required_uid == 0:
            os.chown(current, 0, 0)
            for name in [*dirnames, *filenames]:
                entry = current / name
                if not entry.is_symlink():
                    os.chown(entry, 0, 0)


def obtain_release(sha: str, cfg: TrustedConfig) -> Path:
    sha = validate_sha(sha)
    dest = release_dir(sha, cfg)
    if dest.exists():
        return verify_release_tree(dest, sha, cfg)
    if _test_config is None and cfg.git_remote not in ALLOWED_GIT_REMOTES:
        _fail("unapproved git remote")
    releases_dir(cfg).mkdir(parents=True, exist_ok=True)
    tmp = releases_dir(cfg) / f".tmp-{sha}-{os.getpid()}"
    if tmp.exists():
        _fail("release checkout already in progress")
    try:
        git_cmd(cfg, ["clone", "--quiet", cfg.git_remote, str(tmp)], capture=False)
        assert_commit_object(sha, tmp, cfg)
        assert_reachable_from_approved_ref(sha, tmp, cfg)
        git_cmd(cfg, ["checkout", "--quiet", "--detach", sha], cwd=tmp, capture=False)
        head = git_commit_sha(tmp, cfg)
        if head != sha:
            _fail("checked-out HEAD does not match requested SHA")
        _harden_tree_mode(tmp, cfg)
        verify_release_tree(tmp, sha, cfg, require_dirname=False)
        os.rename(tmp, dest)
    except Exception:
        if tmp.exists():
            shutil.rmtree(tmp, ignore_errors=True)
        raise
    return verify_release_tree(dest, sha, cfg)


def set_active_release(sha: str, cfg: TrustedConfig) -> None:
    dest = verify_release_tree(release_dir(sha, cfg), sha, cfg)
    parent = runtime_link(cfg).parent
    parent.mkdir(parents=True, exist_ok=True)
    rel = os.path.relpath(dest, parent)
    tmp = parent / f".staging-{sha}.tmp"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    os.symlink(rel, tmp)
    os.replace(tmp, runtime_link(cfg))
    if os.geteuid() == 0 and cfg.required_uid == 0:
        os.lchown(runtime_link(cfg), 0, 0)


def active_release(cfg: TrustedConfig) -> Path:
    link = runtime_link(cfg)
    if not link.exists() and not link.is_symlink():
        _fail("active verified release not found")
    if not link.is_symlink():
        _fail("active release must be a root-owned symlink")
    real = link.resolve()
    if not path_is_within(releases_dir(cfg), real):
        _fail("active release is outside trusted releases")
    sha = real.name
    return verify_release_tree(real, sha, cfg)


def compose_command(release: Path, cfg: TrustedConfig) -> list[str]:
    compose_file = release / COMPOSE_REL
    if not path_is_within(release, compose_file.resolve()):
        _fail("unapproved compose file")
    docker = cfg.docker_bin if Path(cfg.docker_bin).is_file() else "docker"
    return [
        docker,
        "compose",
        "--env-file",
        str(cfg.env_file),
        "-p",
        cfg.project,
        "-f",
        str(compose_file),
    ]


def require_images(sha: str, cfg: TrustedConfig) -> None:
    names = image_names(sha)
    if cfg.existing_images is not None:
        missing = [name for name in names if name not in cfg.existing_images]
        if missing:
            _fail("required immutable images are missing")
        return
    docker = cfg.docker_bin if Path(cfg.docker_bin).is_file() else "docker"
    for name in names:
        _run([docker, "image", "inspect", name], cfg=cfg, extra_env={"ATLAS_RELEASE_SHA": sha})


def cmd_deploy(sha: str) -> None:
    cfg = config()
    if PRODUCTION_HEALTH in cfg.health_url and "staging" not in cfg.health_url:
        _fail("production health URL is not allowed")
    if cfg.project != FIXED_PROJECT:
        _fail("unapproved compose project")
    release = obtain_release(sha, cfg)
    extra = {"ATLAS_RELEASE_SHA": sha}
    compose = compose_command(release, cfg)
    _run(compose + ["build", *BUILD_SERVICES], cfg=cfg, extra_env=extra)
    _run(compose + ["up", "-d", "--no-build", *DATA_SERVICES], cfg=cfg, extra_env=extra)
    _run(compose + ["up", "-d", "--no-build", "backend"], cfg=cfg, extra_env=extra)
    migrate = compose + [
        "run",
        "--rm",
        "--no-deps",
        "-v",
        f"{release}:/atlaslm-src:ro",
        "-w",
        "/atlaslm-src",
        "--entrypoint",
        "python",
        "backend",
        "/atlaslm-src/deploy/migrate.py",
        "--root",
        "/atlaslm-src",
    ]
    if not path_is_within(release, (release / MIGRATE_REL).resolve()):
        _fail("refusing to execute atlasdeploy-writable content")
    _run(migrate, cfg=cfg, extra_env=extra)
    _run(compose + ["up", "-d", "--no-build", *APP_SERVICES], cfg=cfg, extra_env=extra)
    set_active_release(sha, cfg)
    _run(["curl", "-fsS", "--max-time", "15", cfg.health_url], cfg=cfg)
    print(f"staging deploy complete for {sha}")


def cmd_rollback(sha: str) -> None:
    cfg = config()
    release = verify_release_tree(release_dir(sha, cfg), sha, cfg)
    require_images(sha, cfg)
    compose = compose_command(release, cfg)
    cmd = compose + ["up", "-d", "--no-build", "--pull", "never", *ROLLBACK_SERVICES]
    if "build" in cmd[cmd.index("up") :]:
        _fail("rollback refused to rebuild")
    _run(cmd, cfg=cfg, extra_env={"ATLAS_RELEASE_SHA": sha})
    set_active_release(sha, cfg)
    print(f"staging rollback selected immutable tags for {sha}")


def cmd_status() -> None:
    cfg = config()
    release = active_release(cfg)
    compose = compose_command(release, cfg)
    _run(compose + ["ps"], cfg=cfg, extra_env={"ATLAS_RELEASE_SHA": release.name})


def cmd_logs() -> None:
    cfg = config()
    release = active_release(cfg)
    compose = compose_command(release, cfg)
    cmd = compose + ["logs", "--no-color", "--tail", "200"]
    if cfg.dry_run:
        _run(cmd, cfg=cfg)
        return
    env = clean_subprocess_env(cfg, {"ATLAS_RELEASE_SHA": release.name})
    try:
        completed = subprocess.run(cmd, check=True, text=True, capture_output=True, env=env)
    except subprocess.CalledProcessError as exc:
        _fail("log collection failed", code=exc.returncode or 1)
    for line in completed.stdout.splitlines():
        print(sanitize_log_line(line))


def parse_command(argv: Sequence[str]) -> tuple[str, str | None]:
    reject_forbidden(argv)
    if len(argv) == 2 and argv[0] == "staging" and argv[1] in {"status", "logs"}:
        return argv[1], None
    if len(argv) == 3 and argv[0] == "staging" and argv[1] in {"deploy", "rollback"}:
        return argv[1], validate_sha(argv[2])
    if argv and argv[0] != "staging":
        _fail("only the staging target is supported")
    _fail("unknown argument")
    raise AssertionError("unreachable")


def main(argv: Sequence[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    maybe_reexec_isolated(argv)
    try:
        action, sha = parse_command(argv)
        if action == "deploy":
            if sha is None:
                _fail("release id must be an exact 40-character lowercase hexadecimal Git SHA")
            cmd_deploy(sha)
        elif action == "rollback":
            if sha is None:
                _fail("release id must be an exact 40-character lowercase hexadecimal Git SHA")
            cmd_rollback(sha)
        elif action == "status":
            cmd_status()
        elif action == "logs":
            cmd_logs()
        else:
            _fail("unknown argument")
    except AtlasLMCtlError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return exc.code
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
